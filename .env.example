# ─── Aplicação ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# ─── Banco (MySQL 8) ──────────────────────────────────────────────────────────
# Se o banco de dev se chamar `dev_cuidador`, troque só o final desta linha.
DATABASE_URL=mysql://sa:masterkey@localhost:3306/cuidador
DATABASE_SSL=false
DATABASE_LOGGING=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=troque-isto-em-producao-access-000000000000
JWT_REFRESH_SECRET=troque-isto-em-producao-refresh-00000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL=60m
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Negócio ──────────────────────────────────────────────────────────────────
TRIAL_DAYS=14
DEFAULT_TIMEZONE=America/Sao_Paulo

# ─── E-mail ───────────────────────────────────────────────────────────────
# `log` (padrão em dev): nada sai da máquina — o convite e o link de senha
# aparecem no terminal. `resend` entrega de verdade e exige RESEND_API_KEY.
MAIL_PROVIDER=log
MAIL_FROM=MNVMA <nao-responda@mnvma.com.br>
MAIL_REPLY_TO=
RESEND_API_KEY=

# ─── Jobs agendados ──────────────────────────────────────────────────────
JOBS_ENABLED=true
DOCUMENT_ALERT_DAYS=30

# ─── Mercado Pago (ver docs/mnvma/03-mercado-pago.md) ─────────────────────────
# Vazio = cobranca desligada: a API sobe, o painel funciona e a tela de planos
# avisa que o checkout nao esta disponivel neste ambiente.
#
# Use SEMPRE as credenciais de teste em dev e staging. Com MP_ACCESS_TOKEN
# preenchido, MP_WEBHOOK_SECRET passa a ser obrigatorio em staging e producao —
# sem ele o webhook nao teria como conferir quem esta chamando.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_BACK_URL=http://localhost:5173/assinatura/retorno
# Em desenvolvimento, aponte para o tunel do ngrok: o Mercado Pago precisa
# alcancar esta URL de fora.
MP_NOTIFICATION_URL=http://localhost:3000/v1/webhooks/mercadopago

# ─── Observabilidade ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
